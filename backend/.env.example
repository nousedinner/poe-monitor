# ============================================
# POE Monitor 环境变量配置
# 复制此文件为 .env 并修改其中的值
# ============================================

# --- MySQL 数据库（docker-compose 自动使用）---
MYSQL_ROOT_PASSWORD=poe_root_2024
MYSQL_PASSWORD=poe_pass_2024

# --- Flask 密钥（改成一个随机字符串）---
SECRET_KEY=your_secret_key_here

# --- JWT 密钥（改成一个随机字符串）---
JWT_SECRET_KEY=your_jwt_secret_key_here

# --- POESESSID 加密密钥（用于加密存储的cookie，至少16个字符）---
POESESSID_ENCRYPTION_KEY=your_encryption_key_here
