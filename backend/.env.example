# 数据库连接
DATABASE_URL=mysql+pymysql://poe:your_password@127.0.0.1/poe_monitor?charset=utf8mb4

# Flask 密钥（生成一个随机字符串）
SECRET_KEY=your_secret_key_here

# JWT 密钥（生成一个随机字符串）
JWT_SECRET_KEY=your_jwt_secret_key_here

# POESESSID 加密密钥（用于加密存储的cookie，至少16个字符）
POESESSID_ENCRYPTION_KEY=your_encryption_key_here
